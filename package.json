{
  "name": "hallowmere",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A fantasy action RPG made with Astra",
  "scripts": {
    "dev": "node --watch scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "worktree": "node scripts/worktree.mjs",
    "dev:worktree": "node scripts/dev-worktree.mjs",
    "build": "node scripts/validate.mjs",
    "generate": "node scripts/generate-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev:network": "node --watch scripts/serve.mjs --network",
    "generate:audio": "node scripts/generate-audio.mjs",
    "configure:multiplayer": "node scripts/configure-multiplayer.mjs"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=22"
  }
}
